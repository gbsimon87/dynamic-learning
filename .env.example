# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.
# NEVER put a real connection string, password, key or secret in THIS file.
# Read by `npm run dev:server`, `npm run audit:*` and `npm run seed`; Vite reads
# the VITE_ ones. Render sets its own values (render.yaml, PROJECT_KNOWLEDGE §6 item 17).

# --- Server-only (never sent to the browser) ---------------------------------

# MongoDB Atlas connection string. Atlas > Cluster > Connect > Drivers.
# Replace <username>, <password> (URL-encode any special characters) and
# <cluster-host>. A database name in the URI is ignored: MONGODB_DB decides.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Which database to use. Unset means dynamic_learning, which is PRODUCTION —
# real learners' progress with no backup. Locally always use the dev database.
# The audit scripts are pointed at production with a one-off override:
#   MONGODB_DB=dynamic_learning npm run audit:accounts
MONGODB_DB=dynamic_learning_dev

# Secret used to sign the session cookie. Any long random string; rotating it
# signs everyone out. Use a different one from production's.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string

# Port the Express server listens on. Locally use 3001 — that is what the Vite
# dev proxy in vite.config.js forwards /api to. On Render, leave this unset:
# Render injects its own PORT and the server reads it.
PORT=3001

# Trusted origin for password-reset links. Unset locally: it falls back to
# http://localhost:5173. Required in production (Render sets it).
# PUBLIC_APP_URL=https://learnwithbix.com

# Email for sign-up and recovery codes (Resend). Set BOTH to turn sending on;
# with neither set, local dev prints codes to the terminal. learnwithbix.com is
# verified in Resend, so EMAIL_FROM must be on it. Use the
# `dynamic-learning-local` key (Sending access), never production's.
RESEND_API_KEY=
EMAIL_FROM=Bix <hello@learnwithbix.com>

# Maximum sign-up + recovery send attempts per UTC day, counted per database
# (default 90), including failed/timed-out sends. Production (80) and dev (20)
# share one Resend account, so keep the total within its daily quota.
# SIGNUP_EMAIL_DAILY_LIMIT=90

# Do not set: NODE_ENV (production only, on Render) and RENDER (set by Render).

# --- Client (Vite) -----------------------------------------------------------
# ⚠️ Anything prefixed VITE_ is inlined into the JS bundle and is PUBLIC.
# Never put a secret behind a VITE_ name. All are read at BUILD time, so a
# change needs a dev-server restart (or a rebuild on Render).

# Which data store driver the app uses (src/data/store/index.js):
#   "true"  -> apiStore.js   (HTTP + cookie session, data in MongoDB; needs
#              `npm run dev:server` running alongside `npm run dev`)
#   anything else / unset -> localStorageStore.js (browser-only, no server)
VITE_USE_API=true

# REST Countries API key for the FlagFinder Skills game. Public by design (it
# ships in the bundle); Render needs it on both services.
VITE_REST_COUNTRIES_API_KEY=

# Dev-only: open every BUILT challenge in Curriculum Mode, ignoring the
# sequential unlock rules, so the whole curriculum can be reached for review
# without completing it in order. A banner appears while it is on.
#   "true"  -> all built challenges playable (only under `npm run dev`)
#   anything else / unset -> normal unlock rules
# It only affects what the picker offers, never stored progress.
VITE_UNLOCK_ALL=false

# --- Scripts -----------------------------------------------------------------

# Optional. Chrome binary for scripts/science-assets/*.mjs; defaults to the
# standard macOS install path.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
