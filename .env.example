# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.
# NEVER put a real connection string, password or secret in THIS file.

# --- Server-only (never sent to the browser) ---------------------------------

# MongoDB Atlas connection string. Atlas > Cluster > Connect > Drivers.
# Replace <username>, <password> (URL-encode any special characters) and
# <cluster-host>. The database name goes after the host.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Secret used to sign the session cookie. Any long random string; rotating it
# signs everyone out. Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string

# Port the Express server listens on. Locally use 3001 — that is what the Vite
# dev proxy in vite.config.js forwards /api to. On Render, leave this unset:
# Render injects its own PORT and the server reads it.
PORT=3001

# --- Client (Vite) -----------------------------------------------------------
# ⚠️ Anything prefixed VITE_ is inlined into the JS bundle and is PUBLIC.
# Never put a secret behind a VITE_ name.

# Which data store driver the app uses (src/data/store/index.js):
#   "true"  -> apiStore.js   (HTTP + cookie session, data in MongoDB)
#   anything else / unset -> localStorageStore.js (browser-only, no server)
# This is read at BUILD time, so changing it requires a rebuild.
VITE_USE_API=false

# Dev-only: open every BUILT challenge in Curriculum Mode, ignoring the
# sequential unlock rules, so the whole curriculum can be reached for review
# without completing it in order. A banner appears while it is on.
#   "true"  -> all built challenges playable
#   anything else / unset -> normal unlock rules
# Read at BUILD time, so changing it requires restarting the dev server.
# Leave this unset (or false) for anything a learner will use — it only
# affects what the picker offers, never stored progress.
VITE_UNLOCK_ALL=false
